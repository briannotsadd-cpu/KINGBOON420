# KINGBOON's dedicated Supabase project only. Never copy XAUUSD credentials here.
# Remote connection requires both values; keep actual secrets in .env.local / server environment.
KINGBOON_DATABASE_URL=
KINGBOON_SUPABASE_PROJECT_REF=
# Legacy local-dev fallback only (not accepted in production or for a remote host).
# Local dev: bash supabase/dev/local-db.sh start
DATABASE_URL=postgres://postgres@localhost:54322/boon
# Required in production: random secret, 16+ characters (hardens stored login codes)
AUTH_PEPPER=
# Emails that become platform admins (approve temples) on their first login, comma separated
PLATFORM_ADMIN_EMAILS=
# Real email delivery via Resend (https://resend.com). Without these, no email is sent and the app says so.
RESEND_API_KEY=
MAIL_FROM=KINGBOON <no-reply@your-domain.example>
